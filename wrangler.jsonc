{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deurbeslaggigant",
  "account_id": "7f788861085c393b77455eb24be40f00",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "deurbeslaggigant" }],
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "deurbeslaggigant-cache" }],
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true }
}
